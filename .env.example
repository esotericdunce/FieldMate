# LiveKit Realtime Voice Transport
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Deepgram Streaming Speech-to-Text (STT)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Groq LLM Reasoning Engine
GROQ_API_KEY=your_groq_api_key

# Rime Neural Text-to-Speech (TTS)
RIME_API_KEY=your_rime_api_key

# Qdrant Vector Memory & Retrieval (Qdrant Cloud)
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Localhost User Identity & Persistence Configuration
# --------------------------------------------------
# FIELDMATE_USER_ID sets the technician identity on localhost.
# - Default: "tech_john_doe" (keeps semantic cache persistent across local runs/restarts).
# - To test multi-user isolation on localhost: change to "tech_alice" or "tech_user_2".
# - In Production: LiveKit automatically extracts each user's authentic identity from their login JWT token.
FIELDMATE_USER_ID=tech_john_doe

# Semantic Cache Settings
FIELDMATE_SEMANTIC_CACHE_ENABLED=true
FIELDMATE_SEMANTIC_CACHE_COLLECTION=fieldmate_semantic_cache
FIELDMATE_SEMANTIC_CACHE_THRESHOLD=0.75
FIELDMATE_SEMANTIC_CACHE_TTL_SECONDS=86400.0
